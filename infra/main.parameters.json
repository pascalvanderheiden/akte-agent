{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "${AZURE_RESOURCE_PREFIX}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "deployObo": {
      "value": "${DEPLOY_OBO=true}"
    },
    "deploySreAgent": {
      "value": "${DEPLOY_SRE_AGENT=false}"
    },
    "sreAgentName": {
      "value": "${SRE_AGENT_NAME}"
    },
    "sreLocation": {
      "value": "${SRE_LOCATION}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    }
  }
}
