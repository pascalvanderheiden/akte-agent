{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "resourcePrefix": {
      "value": "${AZURE_RESOURCE_PREFIX}"
    },
    "principalId": {
      "value": "${AZURE_PRINCIPAL_ID}"
    },
    "agentServiceExists": {
      "value": "${SERVICE_AGENT_SERVICE_RESOURCE_EXISTS=false}"
    },
    "agentServiceReadinessProbeFailureWindowSeconds": {
      "value": "${AGENT_SERVICE_READINESS_PROBE_FAILURE_WINDOW_SECONDS=100}"
    },
    "agentServiceReadinessProbeTimeoutSeconds": {
      "value": "${AGENT_SERVICE_READINESS_PROBE_TIMEOUT_SECONDS=5}"
    },
    "agentServiceLivenessProbePeriodSeconds": {
      "value": "${AGENT_SERVICE_LIVENESS_PROBE_PERIOD_SECONDS=30}"
    },
    "agentServiceLivenessProbeFailureThreshold": {
      "value": "${AGENT_SERVICE_LIVENESS_PROBE_FAILURE_THRESHOLD=3}"
    },
    "agentServiceLivenessProbeTimeoutSeconds": {
      "value": "${AGENT_SERVICE_LIVENESS_PROBE_TIMEOUT_SECONDS=5}"
    },
    "agentServiceLivenessProbeInitialDelaySeconds": {
      "value": "${AGENT_SERVICE_LIVENESS_PROBE_INITIAL_DELAY_SECONDS=30}"
    },
    "oboMcpServerExists": {
      "value": "${SERVICE_OBO_MCP_SERVER_RESOURCE_EXISTS=false}"
    },
    "deployObo": {
      "value": "${DEPLOY_OBO=true}"
    },
    "deploySreAgent": {
      "value": "${DEPLOY_SRE_AGENT=false}"
    },
    "sreAgentName": {
      "value": "${SRE_AGENT_NAME_OVERRIDE}"
    },
    "sreLocation": {
      "value": "${SRE_LOCATION}"
    },
    "principalType": {
      "value": "${AZURE_PRINCIPAL_TYPE=User}"
    }
  }
}
